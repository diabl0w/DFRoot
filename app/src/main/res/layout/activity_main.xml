<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DFRoot"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START AT BOOT"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <Switch
        android:id="@+id/switchBootStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enabled" />

    <Switch
        android:id="@+id/switchAutoSoftReboot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto Soft Reboot" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DIRTYFRAG (CVE-2026-43284)"
        android:textStyle="bold"
        android:paddingTop="16dp"
        android:paddingBottom="4dp" />

    <Button
        android:id="@+id/btnRun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Launch Root" />

    <Switch
        android:id="@+id/switchManualSoftReboot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto Soft Reboot" />

    <ScrollView
        android:id="@+id/outputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/outputView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </ScrollView>

</LinearLayout>
